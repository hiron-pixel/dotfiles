+    #[test]
+    fn serial_mismatch_applies_edits_but_defers_outgoing_state() {
+        let mut serial = SerialState::default();
+        serial.committed(true); // enable + initial state
+        serial.committed(false); // cursor update
+        assert!(serial.receive(1));
+        assert!(serial.deferred);
+        assert!(serial.receive(2));
+        assert!(!serial.deferred);
+        serial.committed(false); // disable
+        serial.committed(true); // enable a different input
+        assert!(!serial.receive(2));
+        assert!(serial.receive(4));
+    }
+
+    #[test]
+    fn serial_counter_wraps_without_resetting_on_enable() {
+        let mut serial = SerialState {
+            sent: u32::MAX - 1,
+            session: u32::MAX - 1,
+            deferred: false,
+        };
+        serial.committed(true);
+        serial.committed(false);
+        assert!(serial.receive(u32::MAX));
+        assert!(serial.deferred);
+        assert!(serial.receive(0));
+        assert!(!serial.deferred);
+        serial.committed(true);
+        assert!(!serial.receive(u32::MAX));
+    }
+
+    #[test]
+    fn unicode_offsets_and_literal_replacement() {
