+        assert!(state.edit(1, 0, "", "", 0, 0).is_none());
+        assert!(state.edit(100, 0, "", "", 0, 0).is_none());
+        assert!(state.edit(0, 0, "", "😀", 1, 1).is_none());
+        assert!(state.edit(0, 0, "", "😀", -1, 0).is_none());
+    }
+
+    #[test]
+    fn truncates_on_boundaries_and_keeps_cursor() {
+        let text = "😀".repeat(3000);
+        for cursor in [0, 2, 3000, 5998, 6000] {
+            let state = Surrounding::new(&text, 0, cursor..cursor, None).unwrap();
+            assert!(state.text.len() <= MAX_BYTES);
+            assert!(state.text.is_char_boundary(state.cursor));
+            assert_eq!(
+                state.start_utf16 + state.text[..state.cursor].encode_utf16().count(),
+                cursor
+            );
+        }
+    }
+
+    #[test]
+    fn selection_and_bad_adjusted_ranges_are_not_advertised() {
+        assert!(Surrounding::new("abc", 0, 0..2, None).is_none());
+        assert!(Surrounding::new("abc", 5, 0..0, None).is_none());
+    }
+
+    #[test]
+    fn empty_commit_and_empty_document_are_valid() {
+        let state = Surrounding::new("", 0, 0..0, None).unwrap();
+        assert_eq!(state.edit(0, 0, "", "", 0, 0).unwrap().range, 0..0);
+    }
+
+    #[test]
+    fn deletion_only_hidden_caret_and_reverse_preedit_selection() {
+        let state = Surrounding::new("abc", 0, 3..3, None).unwrap();
+        let deleted = state.edit(2, 0, "", "", 0, 0).unwrap();
+        assert_eq!(deleted.range, 1..3);
+        assert_eq!(deleted.expected, "bc");
+        let hidden = state.edit(0, 0, "", "😀あ", -1, -1).unwrap();
+        assert_eq!(hidden.selection, 0..0);
+        let reverse = state.edit(0, 0, "", "😀あ", 7, 0).unwrap();
+        assert_eq!(reverse.selection, 3..0);
+        assert!(Surrounding::new("a\0b", 0, 1..1, None).is_none());
+    }
+
+    #[test]
+    fn done_pending_is_taken_and_reset() {
+        let mut pending = Pending {
+            before: 3,
+            committed: Some("x".into()),
+            ..Pending::default()
+        };
+        let received = std::mem::take(&mut pending);
+        assert_eq!(received.before, 3);
+        assert_eq!(pending.before, 0);
+        assert!(pending.committed.is_none());
+    }
