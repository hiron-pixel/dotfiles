+        assert_eq!(state.cursor, "前😀abc".len());
+        let edit = state.edit(3, 3, "漢字", "", 0, 0).unwrap();
+        assert_eq!(edit.range, 3..7);
+        assert_eq!(edit.expected, "abc後");
+        assert_eq!(edit.text, "漢字");
+        assert_eq!(edit.selection, 2..2);
+    }
+
+    #[test]
+    fn excludes_old_preedit_and_accounts_for_its_document_length() {
+        let state = Surrounding::new("前かな😀後", 10, 14..14, Some(11..15)).unwrap();
+        assert_eq!(state.text, "前後");
+        assert_eq!(state.cursor, "前".len());
+        let edit = state.edit(3, 3, "確定", "あ😀", 3, 7).unwrap();
+        assert_eq!(edit.expected, "前かな😀後");
+        assert_eq!(edit.range, 10..16);
+        assert_eq!(edit.marked, 2..5);
+        assert_eq!(edit.selection, 3..5);
+    }
+
+    #[test]
+    fn rejects_partial_codepoints_surrogates_and_out_of_window_deletes() {
+        assert_eq!(utf16_to_byte("😀", 1), None);
