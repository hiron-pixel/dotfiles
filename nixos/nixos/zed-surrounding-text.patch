+//! UTF-8/UTF-16 boundary handling for text-input-v3 version 1.
+//! This module deliberately has no GPUI dependencies so its protocol arithmetic
+//! can be tested without building the editor.
+use std::ops::Range;
+
+pub const MAX_BYTES: usize = 4000;
+
+/// Counts commits on one protocol object, including enable/disable/geometry.
+#[derive(Default, Debug)]
+pub struct SerialState {
+    sent: u32,
+    session: u32,
+    pub deferred: bool,
+}
+
+impl SerialState {
+    pub fn committed(&mut self, new_session: bool) {
+        self.sent = self.sent.wrapping_add(1);
+        if new_session {
+            self.session = self.sent;
+        }
+    }
+
+    pub fn receive(&mut self, serial: u32) -> bool {
+        if (serial.wrapping_sub(self.session) as i32) < 0 {
+            return false;
+        }
+        self.deferred = serial != self.sent;
+        true
+    }
+}
+
+pub fn utf16_to_byte(text: &str, offset: usize) -> Option<usize> {
+    let mut units = 0;
+    for (byte, ch) in text.char_indices() {
+        if units == offset {
+            return Some(byte);
+        }
+        units += ch.len_utf16();
+        if units > offset {
+            return None;
+        }
+    }
+    (units == offset).then_some(text.len())
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Surrounding {
+    pub text: String,
+    pub cursor: usize,
+    pub start_utf16: usize,
+    pub old_preedit: String,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Edit {
+    pub range: Range<usize>,
+    pub expected: String,
+    pub text: String,
+    pub marked: Range<usize>,
+    pub selection: Range<usize>,
+}
+
+impl Surrounding {
+    /// raw starts at an adjusted UTF-16 document offset.
+    /// Ordinary nonempty selections are intentionally unsupported in this patch.
+    pub fn new(
+        raw: &str,
+        start_utf16: usize,
+        selection: Range<usize>,
+        marked: Option<Range<usize>>,
+    ) -> Option<Self> {
+        if raw.contains('\0') {
+            return None;
+        }
+        let mut text = raw.to_owned();
+        let (cursor_doc, old_preedit) = if let Some(marked) = marked {
+            if marked.start > marked.end
+                || selection.start < marked.start
+                || selection.end > marked.end
+            {
+                return None;
+            }
+            let start = utf16_to_byte(raw, marked.start.checked_sub(start_utf16)?)?;
+            let end = utf16_to_byte(raw, marked.end.checked_sub(start_utf16)?)?;
+            let old = raw.get(start..end)?.to_owned();
+            text.replace_range(start..end, "");
+            (marked.start, old)
+        } else {
+            if selection.start != selection.end {
+                return None;
+            }
+            (selection.start, String::new())
+        };
+        let cursor = utf16_to_byte(&text, cursor_doc.checked_sub(start_utf16)?)?;
+        let mut left = cursor.saturating_sub(MAX_BYTES / 2);
+        while !text.is_char_boundary(left) {
+            left += 1;
+        }
+        let mut right = (left + MAX_BYTES).min(text.len());
+        while !text.is_char_boundary(right) {
+            right -= 1;
+        }
+        // At EOF, use the remaining allowance for text before the cursor.
+        if right == text.len() {
+            left = right.saturating_sub(MAX_BYTES);
+            while !text.is_char_boundary(left) {
+                left += 1;
+            }
+        }
+        let start_utf16 = start_utf16 + text[..left].encode_utf16().count();
+        Some(Self {
+            text: text[left..right].to_owned(),
+            cursor: cursor - left,
+            start_utf16,
+            old_preedit,
+        })
+    }
+
+    pub fn edit(
+        &self,
+        before: u32,
+        after: u32,
+        committed: &str,
+        preedit: &str,
+        cursor_begin: i32,
+        cursor_end: i32,
+    ) -> Option<Edit> {
+        let start = self.cursor.checked_sub(before as usize)?;
+        let end = self.cursor.checked_add(after as usize)?;
+        let prefix = self.text.get(..start)?;
+        let before_text = self.text.get(start..self.cursor)?;
+        let after_text = self.text.get(self.cursor..end)?;
+        let range_start = self.start_utf16 + prefix.encode_utf16().count();
+        let expected = format!("{}{}{}", before_text, self.old_preedit, after_text);
+        let range_end = range_start + expected.encode_utf16().count();
+        let committed_len = committed.encode_utf16().count();
+        let preedit_len = preedit.encode_utf16().count();
+        let cursor = |offset: i32| -> Option<usize> {
+            let offset = usize::try_from(offset).ok()?;
+            Some(committed_len + preedit.get(..offset)?.encode_utf16().count())
+        };
+        // -1/-1 is represented as an invisible caret by the editor.
+        let selection = if cursor_begin == -1 && cursor_end == -1 {
+            committed_len..committed_len
+        } else {
+            cursor(cursor_begin)?..cursor(cursor_end)?
+        };
+        Some(Edit {
+            range: range_start..range_end,
+            expected,
+            text: format!("{}{}", committed, preedit),
+            marked: committed_len..committed_len + preedit_len,
+            selection,
+        })
+    }
+}
+
+#[derive(Default, Debug)]
+pub struct Pending {
+    pub committed: Option<String>,
+    pub preedit: Option<String>,
+    pub cursor_begin: i32,
+    pub cursor_end: i32,
+    pub before: u32,
+    pub after: u32,
+    pub delete_requested: bool,
+}
+
+#[cfg(test)]
